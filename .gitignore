/data/
*.db
*.bolt
flows.json
flows.json.bak*
credentials.json

# Helm packaging output
*.tgz

# Go
*.test
*.out
coverage.*

# OS
.DS_Store
Thumbs.db

# Compiled WASM test guest — built by CI, not committed
testdata/wasmguest/*.wasm
testdata/wasmguest/*.h
